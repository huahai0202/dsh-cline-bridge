{
  "name": "dsh-cline-bridge",
  "version": "2.4.2",
  "description": "Cline channel bridge for DeepSeek Harness (DSH): official client headers, multi-key failover that survives the per-key daily free limit, and a settings panel with cross-restart per-key usage stats.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huahai0202/dsh-cline-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/huahai0202/dsh-cline-bridge/issues"
  },
  "homepage": "https://github.com/huahai0202/dsh-cline-bridge#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
